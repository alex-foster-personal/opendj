; Architecture contracts for the Python side, enforced by import-linter.
;
; These are the only quality checks in this repo that fail hard at zero rather
; than ratcheting down from a recorded baseline, because an architecture rule
; with a growing allowance is not a rule. Every current violation is listed
; below as a named, dated exception, so the debt is a shrinking list you can
; read rather than a number you cannot act on.
;
; Run:  python -m scripts.quality_gate --only arch
; or:   uv run --no-project --with-requirements ops/quality/requirements.txt \
;           lint-imports --config .importlinter

[importlinter]
root_packages =
    apps
    scripts
    ops
include_external_packages = True
; An import under `if TYPE_CHECKING:` is never executed, so it cannot start a
; runtime cycle; the module that passes the real object in carries the edge.
exclude_type_checking_imports = True
; The `public_surface` contract type (ADR-NEW-module-contracts) lives in this repo.
contract_types =
    public_surface: scripts.arch_surface_contract.PublicSurfaceContract

; ---------------------------------------------------------------------------
[importlinter:contract:shared-is-the-stable-core]
name = apps.shared imports nothing else from apps
type = layers
containers =
    apps
layers =
    ableton_link : adapters : agentbox : ai_gateway_admin : analysis : analysis_beatgrid : analysis_bench : analysis_key : analysis_loudness : analysis_structure : analysis_waveform : audit : autodj : b2b_booth : b2b_pairing : b2b_session : b2b_sync : b2b_transport : cloud : database : dedup : diagnostics : dj_copilot : engine_core : entitlements : equivalence : feature_flags : genre_infer : library_wheel : lighting : loudness : lyrics : mik : native_tools : open_dj : opendj_cli : pairings : parity : play_analytics : playlist_sets : plugins : reconcile : rekordbox_analyse : rekordbox_ingestion : rescue : set_notes : sets : smartlists : spotify : stems : streaming_transfer : sync : sync_hub : tags : transition_score : vocals : voice : webui
    shared
exhaustive = true
; Measured Sun 17 Aug 2026: apps.shared had 17 dependents and 0 dependencies on
; sibling packages. That is the shape a shared core should have; a single import
; here starts a cycle with whichever package it reaches into.
;
; Until Thu 1 Oct 2026 this was a `forbidden` contract over a package list written
; in August, so every package added later went unchecked (issue #4600). It is now a
; two-layer contract with `exhaustive = true`: a package under apps/ that is missing
; from the first layer FAILS the gate, so the list cannot go stale silently.
;
; Cleared: apps.shared -> apps.database (agents_md_cache, issue #7983); migrations_v17
; no longer imports sync_hub (stale ignores removed). Never add an ignore_imports line:
; move the code down into shared, or up out of it, instead.

; ---------------------------------------------------------------------------
[importlinter:contract:webui-is-the-top-layer]
name = No domain package imports the web UI
type = layers
containers =
    apps
layers =
    engine_core : opendj_cli
    webui
    transition_score
    ableton_link : adapters : agentbox : ai_gateway_admin : analysis : analysis_beatgrid : analysis_bench : analysis_key : analysis_loudness : analysis_structure : analysis_waveform : audit : autodj : b2b_booth : b2b_pairing : b2b_session : b2b_sync : b2b_transport : cloud : database : dedup : diagnostics : dj_copilot : entitlements : equivalence : feature_flags : genre_infer : library_wheel : lighting : loudness : lyrics : mik : native_tools : open_dj : pairings : parity : play_analytics : playlist_sets : plugins : reconcile : rekordbox_analyse : rekordbox_ingestion : rescue : set_notes : sets : smartlists : spotify : stems : streaming_transfer : sync : sync_hub : tags : vocals : voice : shared
exhaustive = true
; apps.webui is the delivery layer: it composes domain packages behind HTTP. When a
; domain package imports back into it you get a cycle, and the domain package can
; no longer be exercised, tested, or shipped without the server. Above it sit the
; entry points that compose the web UI themselves: the engine shell, the CLI and
; the fleet MCP server ((private path)).
;
; Until Thu 1 Oct 2026 this was a `forbidden` contract whose SOURCE list was written
; in August, so engine_core, opendj_cli, fleet_mcp, lyrics and sync_hub imported the
; web UI unchecked (issue #4600). `exhaustive = true` now fails the gate on any
; package missing from the layers.
;
; Never add a line: add the inversion instead.
;   Cleared by SMARTEST-CI round 12 (#3830), measured with lint-imports Tue 6 Oct 2026:
;   smartlists -> webui (playlist_writeback moved to apps.smartlists), lyrics -> webui
;     (stem_artifacts inversion, issue #5010), sync_hub -> webui, and cloud, adapters
;     and webui.server.rb_vendor_pkg -> engine_core (inverted, or annotation-only under
;     exclude_type_checking_imports).
;   Cleared issue #8204 (measured with lint-imports): setup.detect / setup.record moved
;     to apps.shared.setup; preflight_checks imports shared.setup only. This contract
;     has no ignore_imports lines. host_info still lives in engine_core (out of scope);
;     webui does not import it today.

; ---------------------------------------------------------------------------
[importlinter:contract:apps-never-imports-scripts]
name = apps never imports scripts
type = forbidden
source_modules =
    apps
forbidden_modules =
    scripts
; scripts/ is the CLI and operations layer over apps/. An app package that
; imports it pulls the whole tree behind one import (the scripts package reaches
; every domain package), which is what held the 31-scope import cycle together
; until round 12. tests/scripts/test_apps_scripts_import_audit.py guards the
; function-body form of the same edge. The beatgrid report used to be the
; exception (controls.py and scorers/beatgrid_lane.py). Both now import
; apps.analysis_bench.scorers.beatgrid_report, and this contract has no
; ignore_imports left.

; ---------------------------------------------------------------------------
[importlinter:contract:production-code-never-imports-tests]
name = apps never imports the test suite
type = forbidden
source_modules =
    apps
forbidden_modules =
    tests

; ---------------------------------------------------------------------------
[importlinter:contract:b2b-siblings-independent]
name = B2B booth, pairing, session and sync never import each other
type = independence
modules =
    apps.b2b_booth
    apps.b2b_pairing
    apps.b2b_session
    apps.b2b_sync
; Split out of the old Link package Mon 12 Oct 2026 (ADR-0154, which lands with the B2B docs slice of #7955).
; Each builds on Link and never on its siblings, so a booth worker in one package cannot
; reach into another. Two contracts rather than one `layers`: every layers contract here is
; exhaustive over apps/ (tests/quality/test_importlinter_contracts.py).

[importlinter:contract:ableton-link-is-below-b2b]
name = Ableton Link imports no B2B package
type = forbidden
source_modules =
    apps.ableton_link
forbidden_modules =
    apps.b2b_booth
    apps.b2b_pairing
    apps.b2b_session
    apps.b2b_sync
    apps.b2b_transport

[importlinter:contract:module-public-surface]
name = Enforced modules are reached only through their contract
type = public_surface
; ADR-NEW-module-contracts (Fri 9 Oct 2026). For each package below, code outside it
; imports only apps.<pkg>.contract. The composition roots may also import apps.<pkg>.http,
; the module's own router: the delivery layers below, the top-level packages under
; composition_roots, and any __main__ entry point. The contract and the package root import only stdlib,
; pydantic, typing_extensions, annotated_types and other contracts.
;
; This list only grows. tests/quality/test_module_surface_contract.py holds every
; package under apps/ either here or in its frozen list of packages that predate the
; ADR, so a package added after Fri 9 Oct 2026 must be listed here from its first
; commit. To migrate a package: add apps/<pkg>/contract/, repoint its importers, move
; it from the frozen list to this one. There are no ignore_imports, on purpose.
enforced =
    ai_gateway_admin
    analysis_structure
    autodj
    dedup
    library_wheel
    lighting
    pairings
    parity
    play_analytics
    playlist_sets
    reconcile
    rekordbox_analyse
    rekordbox_ingestion
    rescue
    set_notes
    streaming_transfer
    tags
    transition_score
delivery =
    webui
    engine_core
    opendj_cli
composition_roots =
    scripts
; A load by a name no gate can read (`import_module(spec)` with spec from config or a
; CLI flag) could load any implementation unseen, so it is refused in every module the
; graph holds (apps, scripts and ops alike) except in these. The apps entries are plugin
; registries whose targets are data, and dependency probes (`find_spec` over a backend's own
; list of required modules, which imports a dotted name's parents); the scripts entries are
; dev tools that load by path or by computed name (this gate's contract reader, spec loaders
; of sibling files, a tool runner, a remote worker, a sitecustomize syntax check). scripts.ci_plan_sources
; loads nothing: it is the CI planner's static reader, and its tables map each loader name to the
; module that defines it (`PROVIDERS["import_module"]`) so a call counts only through that binding;
; the names are the data it matches, so they cannot be written as tested-only text. scripts.ci_test_selection_rules
; loads nothing either: it reads test files' ASTs to decide selection, and its frozensets name `__import__`,
; `import_module`, `exec`, `eval` and `compile` as the calls it looks for (Sat 31 Oct 2026). apps.plugins.host is the
; plugin store's loader: a plugin's module name comes from its signed catalog entry, so it is data (#6522).
; scripts.suite_census_mutation compiles a mutated copy of a module's AST to test the suite against it (#5636).
; scripts.bench.four_stem_common loads its sibling shootout_spec.py by path, because the Modal bench
; images import it as a top-level module with only the standard library on hand (#9250).
; apps.webui.server.app_wiring discovers the route modules that set
; MOUNT_UNDER_API_PREFIX, so a new route needs no hand list (#9493).
; The gate also refuses an entry that no
; longer loads that way, so this list only shrinks; add to it only in a PR that says why
; the target cannot be named in source.
dynamic_loaders =
    apps.analysis.backends
    apps.analysis.backends.own_key
    apps.analysis.queue_cli
    apps.analysis_bench.cli
    apps.analysis_bench.scorers
    apps.open_dj.registry
    apps.plugins.host
    apps.sets.classify
    apps.sets.classify.model
    apps.vocals.from_stems
    apps.webui.server.app_wiring
    scripts.arch_contract_schema
    scripts.bench.four_stem_common
    scripts.build_engine_payload
    scripts.ci_plan_sources
    scripts.ci_stale_install_guard
    scripts.ci_test_selection_rules
    scripts.lyrics_stem_coverage
    scripts.modal_align_spike
    scripts.modal_beat_farm
    scripts.modal_vocal_farm
    scripts.native10_offline_acceptance
    scripts.pytest_tree_read_census
    scripts.selection_reach_census
    scripts.stems_modal_worker
    scripts.suite_census_mutation
    scripts.worktree_tools
