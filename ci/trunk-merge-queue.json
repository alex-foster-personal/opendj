{
  "repo": {
    "host": "github.com",
    "owner": "maintainer",
    "name": "music-dj-tools"
  },
  "targetBranch": "main",
  "mode": "single",
  "mergeMethod": "merge_commit",
  "concurrency": 3,
  "batch": true,
  "batchingMinSize": 4,
  "batchingMaxWaitTimeMinutes": 5,
  "bisectionConcurrency": 6,
  "optimizationMode": "bisection_skip_redundant_tests",
  "canOptimisticallyMerge": true,
  "pendingFailureDepth": 1,
  "testingTimeoutMinutes": 300,
  "directMergeMode": "off",
  "createPrsForTestingBranches": true,
  "commentsEnabled": true,
  "commandsEnabled": true,
  "statusCheckEnabled": false,
  "extensionEnabled": true,
  "labelCommandsEnabled": true,
  "enqueueingLabel": "queue",
  "stateLabelsEnabled": true,
  "notReadyTimeoutHours": 24,
  "allowedBotSubmitters": [
    "claude[bot]",
    "github-actions[bot]",
    "opendj-debtlog-threads[bot]",
    "opendj-dep-pr-gate[bot]",
    "opendj-devops-ci-sentinel[bot]",
    "opendj-devops-kpi[bot]",
    "opendj-devops-trunk-merge[bot]",
    "opendj-gate-fast[bot]",
    "opendj-governor[bot]",
    "opendj-idd-core[bot]",
    "opendj-idd-delegate[bot]",
    "opendj-log-merge[bot]",
    "opendj-main-failing-tests[bot]",
    "opendj-main-merge[bot]",
    "opendj-merge-gate[bot]",
    "opendj-ratchet-gate[bot]",
    "opendj-scout[bot]",
    "renovate[bot]"
  ],
  "requiredStatuses": [
    "e2e gate (webkit artifact + hermetic chromium)",
    "frontend unit + check + build",
    "pytest fast lane (shard 1 of 5)",
    "pytest fast lane (shard 2 of 5)",
    "pytest fast lane (shard 3 of 5)",
    "pytest fast lane (shard 4 of 5)",
    "pytest fast lane (shard 5 of 5)",
    "quality ratchet (lint debt, complexity, coupling, dead code)",
    "reqs-check + native wheel + contract drift"
  ]
}
