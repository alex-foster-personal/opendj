*.patch -whitespace

# Append-only planning ledgers: union removes local rebase merge work only.
# GitHub does not honor .gitattributes merge strategies for PR mergeability.
.planning/REQUIREMENTS.md merge=union
(private path) merge=union
(private path) merge=union
(private path) merge=union
# Line endings (Windows parity, spike S2 / build B0): LF in the working tree on
# every host, so byte-pinned fixtures hash the same on a Windows checkout with
# core.autocrlf=true as on macOS. Fixtures are opted out of conversion entirely
# because they are compared byte-for-byte against MANIFEST.json digests.
* text=auto eol=lf
tests/**/fixtures/** -text
# Committed with CRLF on purpose (upstream artifacts); never renormalize.
(private path)/*.csv -text
(private path)/*.csv -text
apps/desktop/setup/Anybody-OFL.txt -text
apps/webui/frontend/static/fonts/Anybody-OFL.txt -text
scripts/bench/model_shootout.json -text
# Windows shells want CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Machine-written files. linguist-generated collapses them in GitHub diffs and
# drops them from language stats; it changes nothing about merging or checkout.
# fleet-af `code_budgets/census.py` counts these as data or generated, in bytes.
(private path)/** linguist-generated=true
tools/deck-diagrams/devices/**/*.json linguist-generated=true
tools/deck-diagrams/devices/**/*.html linguist-generated=true
apps/webui/openapi.json linguist-generated=true
apps/webui/frontend/src/lib/api-types.ts linguist-generated=true
.test_durations linguist-generated=true
pylock.*.toml linguist-generated=true
# Byte-pinned text fixtures: each file's sha256 and size are recorded in its
# directory's manifest.json and checked before use, so a checkout must hand
# back the committed bytes unchanged. Without this, core.autocrlf=true on
# Windows rewrites LF to CRLF and every pin fails (v5.sql hashed to exactly
# the CRLF digest on the Windows parity runner, Wed 14 Oct 2026).
tests/fixtures/schema/v5.sql -text
tests/fixtures/jev/*.json -text
(private path)/*.json -text
tests/fixtures/playlist-legacy-order-keys/*.sql -text
(private path)/*.jsonl -text
(private path)/*.tsv -text
# Frontend captured fixtures pin their own sha256 in a sibling manifest.
apps/webui/frontend/tests/unit/fixtures/*.json -text
