{
  "name": "opendj-desktop-electron",
  "productName": "Open DJ",
  "version": "1.0.0-alpha.1",
  "private": true,
  "description": "Open DJ desktop shell on Electron: boots the bundled engine and opens a Chromium window onto it. Phase 21, beside the Tauri shell until cutover.",
  "main": "dist/main.js",
  "opendj": {
    "identifier": "com.opendj.desktop"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && node --test --test-reporter=tap 'dist-test/test/*.test.js'",
    "start": "tsc -p tsconfig.json && electron .",
    "e2e": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && node --test --test-reporter=tap --test-concurrency=1 'dist-test/e2e/*.e2e.js'",
    "live-proof": "node scripts/live-proof.mjs",
    "pack:dir": "tsc -p tsconfig.json && node scripts/stamp-build.mjs && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir --mac --arm64 && node scripts/verify-pack.mjs",
    "pack:dir:linux": "tsc -p tsconfig.json && node scripts/stamp-build.mjs && electron-builder --dir --linux --publish never"
  },
  "build": {
    "appId": "com.opendj.desktop",
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "payload",
        "to": "payload"
      },
      {
        "from": "../setup",
        "to": "setup"
      }
    ],
    "mac": {
      "icon": "assets/icon.png",
      "identity": null,
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "executableName": "opendj-electron",
      "category": "Audio",
      "target": [
        "dir"
      ]
    }
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^22.19.0",
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "typescript": "^5.7.2"
  }
}
