{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open DJ",
  "version": "1.0.0-alpha.1",
  "identifier": "com.opendj.desktop",
  "build": {
    "frontendDist": "../setup"
  },
  "app": {
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "open-dj",
    "category": "Music",
    "shortDescription": "Open DJ desktop shell",
    "longDescription": "Open DJ. The app carries its own engine: a relocatable CPython runtime, the engine code and the built interface, staged into Contents/Resources/payload by scripts/build_engine_payload.py. Launching the app starts that engine on a free loopback port and opens a window onto it. No source checkout is required.",
    "resources": {
      "payload": "payload"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "bundleVersion": "1.0.0",
      "entitlements": "./Entitlements.app.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/alex-foster-personal/issue-assets/releases/latest/download/latest.json"
      ],
