<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the Developer ID app bundle itself (tauri.conf.json
  bundle.macOS.entitlements). The engine payload's executables carry their
  own, in Entitlements.engine.plist.

  WHY audio-input. The app is signed with the hardened runtime, which
  notarization requires, and a hardened app without this key is refused every
  audio INPUT silently: no permission prompt, just silence. Two features read
  an input: set recording (SET-10, SET-11), where the engine's odj-audio,
  attributed to this app by macOS privacy (TCC), captures the input the DJ
  picked on the REC button (usually a loopback such as BlackHole), and carries
  the same key itself (Entitlements.engine.plist); and the
  headphone cue latency calibration (CUEOUT-11), which listens briefly in the
  web view. NSMicrophoneUsageDescription in Info.plist is the prompt text.

  The justfile re-seals the bundle after the icon install with
  --preserve-metadata=entitlements, or this key would be dropped there.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
