{
  "name": "music-dj-tools-webui",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:unit": "svelte-kit sync && node --test --test-concurrency=1 --test-timeout=60000 tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:performance": "playwright test --config tests/e2e/playwright.performance.config.ts",
    "api:gen": "openapi-typescript ../openapi.json -o src/lib/api-types.ts || echo 'regen skipped'",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/sveltekit": "10.5.10",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.8.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/node": "^22.20.1",
    "esbuild": "0.21.5",
    "openapi-typescript": "^7.4.0",
    "storybook": "10.5.10",
    "svelte": "^5.1.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "signalsmith-stretch": "1.3.2"
  }
}
