{
  "name": "music-dj-tools-webui",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && pnpm check:react",
    "check:react": "tsc -p tsconfig.react.json",
    "check:unit-seams": "node scripts/unit-test-seam-check.mjs",
    "bundle:charge": "node scripts/bundle-charge.mjs",
    "test:unit": "svelte-kit sync && pnpm run check:unit-seams && node --experimental-strip-types --test --test-reporter=tap --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=junit-unit.xml --test-concurrency=4 --test-timeout=120000 tests/unit/*.test.mjs",
    "test:unit:slow": "svelte-kit sync && pnpm run check:unit-seams && node --experimental-strip-types --test --test-reporter=tap --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=junit-unit-slow.xml --test-concurrency=1 --test-timeout=120000 tests/unit/slow/*.test.mjs",
    "test:unit:all": "svelte-kit sync && pnpm run check:unit-seams && node --experimental-strip-types --test --test-reporter=tap --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=junit-unit-all.xml --test-concurrency=4 --test-timeout=120000 tests/unit/*.test.mjs tests/unit/slow/*.test.mjs",
    "test:e2e": "uv sync --locked --extra dev --extra analysis --extra spotify && uv run --no-sync python -m apps.webui.port_config claim && playwright test",
    "test:live:wave-raf": "node tests/live/wave-row-raf-attribution.mjs",
    "test:live:playhead-smoothness": "node tests/live/playhead-smoothness.mjs",
    "test:live:device-latency-floor": "node tests/live/device-latency-floor.mjs",
    "test:live:stem-decode-workers": "node tests/live/stem-decode-workers.mjs",
    "test:live:preview-beat-snap": "node tests/live/preview-beat-snap-harness.mjs",
    "test:e2e:performance": "playwright test --config tests/e2e/playwright.performance.config.ts",
    "test:e2e:performance:smoke": "PERFORMANCE_E2E_FIXTURE=0 PERFORMANCE_E2E_SMOKE=1 playwright test --config tests/e2e/playwright.performance.config.ts --grep @performance-smoke --max-failures=1 --reporter=list",
    "test:e2e:performance:headed": "playwright test --config tests/e2e/playwright.performance.config.ts --headed",
    "test:e2e:cue-marker-qa": "PERFORMANCE_E2E_FIXTURE=0 PERFORMANCE_E2E_CUE_QA=1 playwright test --config tests/e2e/playwright.performance.config.ts performance-cue-marker-qa.spec.ts",
    "test:e2e:performance:autoplay-proof": "PERFORMANCE_E2E_FIXTURE=0 PERFORMANCE_E2E_AUTOPLAY=0 PERFORMANCE_E2E_AUDIO_ACTIVATION=auto playwright test --config tests/e2e/playwright.performance.config.ts --grep @performance-autoplay-proof --reporter=list",
    "test:e2e:vocals-demucs-overlay": "MDT_LIVE_DEMUCS_ACCEPTANCE=1 playwright test --config tests/e2e/playwright.vocals-demucs-overlay.config.ts",
    "api:gen": "openapi-typescript ../openapi.json -o src/lib/api-types.ts && node scripts/compact-headphone-api-types.mjs",
    "storybook": "pnpm sandbox:msw && storybook dev -p 6006",
    "build-storybook": "pnpm sandbox:msw && storybook build",
    "design-system:build": "node scripts/build-design-system.mjs",
    "test:design-system": "node --test --test-reporter=tap tests/unit/design-system-bundle.test.mjs",
    "test:contracts": "pnpm sandbox:msw && vitest run --project storybook --project storybook-react",
    "storybook:react": "pnpm sandbox:msw && storybook dev -c .storybook-react -p 6007",
    "build-storybook:react": "pnpm sandbox:msw && storybook build -c .storybook-react -o storybook-static-react",
    "story:parity": "node scripts/story-parity.mjs",
    "test:contracts:watch": "pnpm sandbox:msw && vitest --project storybook",
    "sandbox:msw": "msw init .storybook/msw --save=false"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.48.0",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react-vite": "10.5.10",
    "@storybook/sveltekit": "10.5.10",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.8.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "esbuild": "0.25.0",
    "msw": "2.15.0",
    "msw-storybook-addon": "2.0.7",
    "openapi-typescript": "^7.4.0",
    "pixelmatch": "7.1.0",
    "playwright": "1.61.1",
    "pngjs": "7.0.0",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "storybook": "10.6.2",
    "svelte": "^5.1.0",
    "svelte-check": "^4.0.0",
    "terser": "^5.51.2",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "4.1.11"
  },
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.2.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@wasm-audio-decoders/flac": "0.2.11",
    "dompurify": "3.4.17",
    "marked": "18.1.0",
    "openapi-fetch": "0.17.0",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.6",
    "signalsmith-stretch": "1.3.2"
  }
}
