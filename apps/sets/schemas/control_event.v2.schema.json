{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://music-dj-tools/schemas/control_event.v2.schema.json",
  "title": "ControlEventV2",
  "description": "One control change on a recorded set, timed against the master output sample clock (SETREC-03).",
  "type": "object",
  "required": [
    "v",
    "session_id",
    "seq",
    "sample",
    "sample_rate",
    "wall_clock",
    "control",
    "value",
    "kind",
    "source"
  ],
  "properties": {
    "v": { "type": "integer", "const": 2 },
    "session_id": { "type": "string", "minLength": 1 },
    "seq": { "type": "integer", "minimum": 0 },
    "sample": { "type": "integer", "minimum": 0 },
    "sample_rate": { "type": "integer", "minimum": 1 },
    "wall_clock": { "type": "string", "minLength": 1 },
    "control": { "type": "string", "minLength": 1 },
    "value": {
      "oneOf": [
        { "type": "number" },
        { "type": "boolean" },
        { "type": "string" },
        { "type": "object" },
        { "type": "null" }
      ]
    },
    "kind": { "type": "string", "enum": ["set", "trigger"] },
    "source": { "type": "string", "enum": ["user", "controller", "agent", "replay"] },
    "deck": { "type": ["integer", "null"], "minimum": 1, "maximum": 4 }
  },
  "additionalProperties": false
}
