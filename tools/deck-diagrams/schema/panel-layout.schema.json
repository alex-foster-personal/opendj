{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://music-dj-tools.local/schema/opendj-panel-layout-1.schema.json",
  "title": "OpenDJ panel layout v1 (ADR-0137)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "device",
    "display_name",
    "units",
    "panel",
    "device_map",
    "controls"
  ],
  "properties": {
    "format": { "const": "opendj-panel-layout/1" },
    "device": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "display_name": { "type": "string", "minLength": 1 },
    "units": { "const": "mm" },
    "measured": { "type": "boolean" },
    "panel": { "$ref": "#/$defs/panel" },
    "device_map": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*_MAP$"
    },
    "sources": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "out_of_scope": {
      "type": "array",
      "items": { "type": "string" }
    },
    "scaffold": {
      "type": "object",
      "additionalProperties": true
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/control" }
    }
  },
  "$defs": {
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["w", "d"],
      "properties": {
        "w": { "type": "number", "exclusiveMinimum": 0 },
        "d": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "wire": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ch", "kind", "id"],
      "properties": {
        "ch": { "type": "integer", "minimum": 1, "maximum": 16 },
        "kind": { "type": "string", "enum": ["note", "cc"] },
        "id": { "type": "integer", "minimum": 0, "maximum": 127 }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fig",
        "type",
        "label",
        "does",
        "x",
        "y",
        "w",
        "h",
        "section",
        "midi",
        "shift_midi"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "fig": { "type": "string" },
        "type": {
          "type": "string",
          "enum": [
            "jog",
            "fader",
            "knob",
            "pad",
            "button",
            "crossfader",
            "encoder"
          ]
        },
        "label": { "type": "string", "minLength": 1 },
        "does": { "type": "string", "minLength": 1 },
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "w": { "type": "number", "exclusiveMinimum": 0 },
        "h": { "type": "number", "exclusiveMinimum": 0 },
        "section": {
          "type": "string",
          "enum": ["deck", "mixer", "performance", "effect", "browse"]
        },
        "midi": {
          "description": "null: the maker publishes no wire identity for this control; it renders unwired and inert",
          "anyOf": [{ "$ref": "#/$defs/wire" }, { "type": "null" }]
        },
        "shift_midi": {
          "anyOf": [{ "$ref": "#/$defs/wire" }, { "type": "null" }]
        }
      }
    }
  }
}
