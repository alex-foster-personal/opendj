{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://music-dj-tools.local/schema/opendj-panel-reference-1.schema.json",
  "title": "OpenDJ panel reference trace v1 (ADR-0137)",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "device", "units", "measured", "panel", "controls"],
  "properties": {
    "format": { "const": "opendj-panel-layout/1" },
    "device": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "units": { "const": "mm" },
    "measured": { "type": "boolean" },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["w", "d"],
      "properties": {
        "w": { "type": "number", "exclusiveMinimum": 0 },
        "d": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": true
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ref_control" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "measured": { "const": true } }, "required": ["measured"] },
      "then": {
        "properties": {
          "controls": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["px"],
              "properties": {
                "px": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": { "type": "integer" }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "ref_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "px", "x", "y", "w", "h"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "px": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": { "type": "integer" }
            },
            { "type": "null" }
          ]
        },
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "w": { "type": "number", "exclusiveMinimum": 0 },
        "h": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
