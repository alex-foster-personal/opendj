{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://music-dj-tools.local/schema/controller-probe/expected_map.schema.json",
  "title": "Controller probe expected map",
  "type": "object",
  "additionalProperties": false,
  "required": ["device", "vendor", "usb", "source", "control_count", "controls"],
  "properties": {
    "device": { "const": "DDJ-FLX4" },
    "vendor": { "type": "string", "minLength": 1 },
    "usb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "vid", "pid"],
      "properties": {
        "name": { "const": "DDJ-FLX4" },
        "vid": { "type": ["string", "null"] },
        "pid": { "type": ["string", "null"] }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "filename"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "filename": { "type": "string", "minLength": 1 }
      }
    },
    "control_count": { "type": "integer", "minimum": 1 },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/control" }
    }
  },
  "$defs": {
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "fig",
        "section",
        "deck",
        "shift",
        "ch",
        "kind",
        "code",
        "status"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "fig": { "type": "string", "minLength": 1 },
        "section": {
          "type": "string",
          "enum": ["deck", "mixer", "browse", "performance", "effect"]
        },
        "deck": {
          "oneOf": [{ "type": "integer", "enum": [1, 2] }, { "type": "null" }]
        },
        "shift": { "type": "boolean" },
        "ch": { "type": "integer", "minimum": 1, "maximum": 16 },
        "kind": { "type": "string", "enum": ["note", "cc", "pitchbend"] },
        "code": { "type": "integer", "minimum": 0, "maximum": 127 },
        "status": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 128,
              "maximum": 159,
              "description": "note on/off 0x80-0x9F"
            },
            {
              "type": "integer",
              "minimum": 176,
              "maximum": 191,
              "description": "control change 0xB0-0xBF"
            },
            {
              "type": "integer",
              "minimum": 224,
              "maximum": 239,
              "description": "pitch bend 0xE0-0xEF"
            }
          ]
        }
      }
    }
  }
}
