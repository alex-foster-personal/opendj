# music-dj-tools — environment variable reference (.env.sample)
#
# This file is the authoritative list of environment variables consumed by
# music-dj-tools at runtime. Copy to `.env` (gitignored) for local dev, or
# prefer Doppler for anything sensitive (see docs/operator-setup.md).
#
# Secrets (Doppler project `construct` / config `dev_af` is the canonical
# source of truth; values below are illustrative placeholders only).

# Claude API key — used by the USB/Pioneer agent (apps/sync/usb/pioneer/agent.py).
ANTHROPIC_API_KEY=

# Groq API key — used by voice STT (apps/voice/stt.py) for whisper-via-Groq.
GROQ_API_KEY=

# xAI API key -- used by settings AI search/apply and copilot explainers.
XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# Fast model for settings AI search/apply (Warp-style settings overlay).
# XAI_MODEL=grok-4-1-fast-non-reasoning
# COPILOT_EXPLAIN_TIMEOUT_MS=2500

# Spotify developer app client id — used by the Spotify importer
# (apps/spotify/client.py). Pair with SPOTIFY_CLIENT_SECRET stored in Doppler.
SPOTIFY_CLIENT_ID=

# Picovoice Porcupine access key — used by the wake-word backend
# (apps/voice/wake.py). Required only when VOICE_BACKEND selects pvporcupine.
PICOVOICE_ACCESS_KEY=

# Voice stack configuration (apps/voice/*). All optional; defaults in code.

# Wake-word backend selector (openwakeword | pvporcupine). See apps/voice/wake.py.
VOICE_BACKEND=openwakeword

# macOS `say` voice used by the TTS fallback (apps/voice/tts.py). Default "the maintainer".
VOICE_SAY_VOICE=the maintainer

# Filesystem path to the Porcupine wake-word keyword file (apps/voice/wake.py).
# Only used when VOICE_BACKEND=pvporcupine.
VOICE_WAKE_KEYWORD_PATH=

# Filesystem path to an openWakeWord ONNX model file (apps/voice/wake.py).
VOICE_WAKE_MODEL_PATH=

# Web UI + cloud binding (apps/webui/server/*, apps/cloud/config.py).

# Local development ports are allocated by `just webui-ports-claim` and written
# to the ignored root `.env`. Leave both blank when copying this sample.
MUSIC_DJ_BACKEND_PORT=
MUSIC_DJ_FRONTEND_PORT=

# Interface the FastAPI server binds to. Default 127.0.0.1 (loopback).
# Override only on trusted LANs; an X-Bind-Warning header is added when not 127.0.0.1.
MUSIC_DJ_BIND_HOST=127.0.0.1

# Hostname advertised in cloud-sync metadata and the web UI. Default: socket.gethostname().
MUSIC_DJ_HOSTNAME=

# Comma-separated hostnames a reverse proxy may present in the Host header to
# the vite dev server. Blank means loopback only, which is vite's own default.
# Needed by the tailnet remote runner: `tailscale serve` forwards the MagicDNS
# name, and vite 5.4.12+ answers 403 to any Host not listed here.
# Bare hostnames only - no scheme, port or wildcard.
MUSIC_DJ_ALLOWED_HOSTS=

# Comma-separated SSH destinations for agentbox, IN ADDITION to the bare ssh
# alias `agentbox`. Set this to the deployment's MagicDNS name when agentbox is
# reached by that name; the tailnet label is deployment-specific, so it is
# configured rather than spelled in the tracked tree. Read from the PROCESS
# environment, not this file (apps/webui/run_agentbox.py). Unset leaves the bare
# alias, which is a complete allowlist for a deployment that reaches the box by
# name. A destination that is not listed is refused, loudly.
# MDT_AGENTBOX_SSH_HOSTS=agentbox.example-tailnet.ts.net

# S3-compatible bucket names for Litestream cloud sync (apps/cloud/config.py,
# apps/cloud/litestream.yml, scripts/r2-bootstrap.sh).
MUSIC_DJ_STATE_BUCKET=music-dj-state
MUSIC_DJ_AUDIO_BUCKET=music-dj-audio

# Dev-only flag: skip the TSAF PLAYLIST_TYPE_LEAF startup assertion in
# apps/sync/playlist_apply.py when no live DB is reachable. Equivalent to
# passing --skip-tsaf-validation on the CLI.
MDJ_SKIP_TSAF_VALIDATION=

# Friend share (public hostname, not Tailscale). Daemon stays on 127.0.0.1.
# Cloudflare Tunnel + Access is the outer door. These are the app-level belt.
# MUSIC_DJ_SHARE_HOST=odj.example.com
# MUSIC_DJ_SHARE_AUTH=cloudflare-access
# MUSIC_DJ_SHARE_TOKEN=  # legacy explicit MUSIC_DJ_SHARE_AUTH=token only
# MUSIC_DJ_SHARE_READ_ONLY=1
# MUSIC_DJ_SHARE_ORIGIN=https://odj.example.com
# MDT_AUDIO_MIN_VENUE=naughty_step
# MDT_AUDIO_MAX_VENUE=stadium
# MDT_AUDIO_SHARE_MAX_VENUE=warehouse
# MDT_PATH_MAP=/root/music-dj-tools/data/path-map.json

# Library residency. local = native Mac paths. remote = crate path-map on
# agentbox. Unset is treated as local only on darwin. Do not guess from hostname.
# MDT_LIBRARY_MODE=remote
# MDT_CRATE_ROOT=/data/mdt-crate

# Crate owner-Mac pull lane (apps/webui/crate_sync.py). All three are read when
# the lane actually runs, and an unset value fails loudly rather than defaulting
# to a path that exists on one machine.
# MDT_OWNER_SSH_TARGETS=user@owner-mac
# MDT_OWNER_SSH_KEY=/root/.ssh/example_owner_pull_ed25519
# MDT_OWNER_REPO=/Users/user/code/music-dj-tools

# CI health watchdog (scripts/ci_health_notify.sh). REQUIRED, not defaulted: the
# PRIMARY alert channel mails this address, and an unset value fails the run's
# precondition rather than delivering somewhere nobody reads. Lives in the
# environment or the launchd plist's EnvironmentVariables, never in the tree.
# MDT_ALERT_EMAIL=someone@example.com

# Error telemetry (Sentry). Tri-state; unset lets the build decide: a repo
# checkout is OFF (a DSN in this file is not consent), a packaged dmg is ON
# under the DSN baked into its payload (OBS-04; testers opt out with a
# `telemetry-opt-out` file in the engine data directory). Setting it to 1 with
# no SENTRY_DSN is a HARD ERROR at startup rather than a silent no-op, so a
# machine that was told to report errors either reports them or says why.
# Nothing is sent while a deck is playing or audible (the live-set gate);
# those events stay in the local logs.
# A dmg build reads OPENDJ_SENTRY_DSN_BACKEND_SHIP (Doppler) at build time and
# never this SENTRY_DSN, which is the preview key.
# Full inventory of what is and is not sent: docs/telemetry.md.
# OPENDJ_TELEMETRY=1
# SENTRY_DSN=https://<key>@<org>.ingest.de.sentry.io/<project>
# One of dev / preview / fleet / ship; unset lets the build decide.
# SENTRY_ENVIRONMENT=preview
# Request tracing is OFF by default. A fraction in (0, 1] traces that share of
# requests through the same scrubber and live-set gate as errors. Spends the
# span quota, not the error quota.
# SENTRY_TRACES_SAMPLE_RATE=0
# Session replay for consented test users (OBS-06): the open-dj-fe DSN. The
# engine derives the Loader Script URL from it; the page loads that script only
# after the tester accepts the terms (OBS-05). A dmg bakes it from Doppler's
# OPENDJ_SENTRY_DSN_FRONTEND instead of reading this.
# SENTRY_FRONTEND_DSN=https://<key>@<org>.ingest.de.sentry.io/<fe-project>
# Fraction of consented sessions recorded (default 1.0; lower it if replay
# quota climbs).
# SENTRY_REPLAY_SESSION_SAMPLE_RATE=1.0
