# Python
__pycache__/
*.pyc
.mypy_cache/
.venv/

# pnpm content-addressable store (accidentally committed at repo root; never track)
.pnpm-store/
# corepack/pnpm local cache (accidentally committed in a sweep round; never track)
.xdg-cache/
.tmp/
.env
*.egg-info/

# Python build artefacts (setuptools / build)
/dist/
/build/

# Data artifacts (DBs, CSVs, XML exports can be huge / sensitive)
data/*
!data/.gitkeep

# Working copies of live DBs
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.xml

# Test fixtures MUST be committed (they're tiny, stripped-down, safe).
!tests/fixtures/**/*.db
!tests/fixtures/**/*.db-wal
!tests/fixtures/**/*.db-shm
!tests/fixtures/**/*.sqlite
!tests/fixtures/**/*.sqlite-wal
!tests/fixtures/**/*.sqlite-shm
# But ignore the temp decrypted file the fixture builder leaves around.
tests/fixtures/rekordbox/_tmp_plain.db
# Defense-in-depth for the coming history rewrite (rekordbox.extern, PR #718):
# once tests/fixtures/rekordbox/ is stripped from history, a locally
# regenerated master.plain.db (scripts/make_rb_fixture.py --force) must not
# be picked up by a routine `git add -A` and recommit real track titles,
# Spotify IDs and filesystem paths. This override has NO effect on the
# currently tracked copy (gitignore never hides an already-tracked path); it
# only takes effect once that path stops being tracked.
tests/fixtures/rekordbox/master.plain.db

# Defense-in-depth: the real USB fixture must never include the 2.9 GB of
# audio under Contents/. We never rsync it in, but guard against accidents.
tests/fixtures/rb-usb-export/Contents/
# Also guard against re-adding the credential token we strip during copy.
tests/fixtures/rb-usb-export/PIONEER/extracted/
# Defense-in-depth for the coming history rewrite (rb-usb-export.extern,
# rb-usb-export-onetera-20260805.extern, PR #718): once these directories are
# stripped from history, restoring either one to its old in-repo location
# must not be picked up by a routine `git add -A` and recommit the real
# PIONEER metadata and artwork they carry. Has NO effect on the currently
# tracked copies (gitignore never hides an already-tracked path); only takes
# effect once each path stops being tracked.
tests/fixtures/rb-usb-export/
tests/fixtures/rb-usb-export-onetera-20260805/

# Editor
.DS_Store
.vscode/
.idea/

# Test + coverage artifacts (regenerated every run)
.pytest_cache/
.coverage
.coverage.*
htmlcov/
# coverage-matrix.md is a build artifact, fully derived from reqs.json x
# @pytest.mark.requirement markers. It was committed once (19d91fed) before
# this rule existed (80bb80a5); a tracked file ignores .gitignore, so the
# rule sat inert and every partial pytest run left the tree dirty with
# figures scoped to that run. Untracked now -- CI publishes the full-run
# copy as the `coverage-matrix` artifact (.github/workflows/ci.yml).
coverage-matrix.md

# Phase 9 -- Spotify API cache + per-import artifacts (may contain user
# playlist metadata). The OAuth token lives outside the repo at
# ~/.music-dj-tools/ (not here) per convention. These patterns are
# already caught by the blanket ``data/*`` rule above but we list them
# explicitly for clarity.
data/spotify/

# Baked Desktop-app Google OAuth client. The payload builder writes this
# next to google_oauth_client.py inside the staged payload only. Never
# commit a copy that landed in the repo checkout by accident.
apps/shared/bundled_google_oauth.json

# --- Phase 14 -- voice commands ---
apps/voice/models/*.bin
apps/voice/models/*.onnx
apps/voice/models/*.mlmodelc/
apps/voice/models/*.ppn
vendor/whisper.cpp/

# --- Prototype C (CAT-06) -- Rekordbox computer-use agent traces ---
# Every run writes screenshots + action JSON under this directory. Can
# include screen contents with user library metadata; never commit.
apps/sync/usb/pioneer/traces/
# Voice daemon runtime logs (all gitignored under data/voice/.gitkeep).
data/voice/*.log
data/voice/*.jsonl
data/voice/settings.sqlite*

# --- Phase 10 -- USB sync ---
# Local-only drive profiles (they contain user volume labels / UUIDs).
usb-profiles/local/
# Hash cache + reversal scripts + verify JSON dumps.
data/usb/

# Root npm install (@trunkio/launcher for `npm run lint` / `npm run fmt`).
/node_modules/

# Dependency trees the persistent CI runners keep between jobs, at ANY depth:
# scripts/ci_clean_untracked.sh keeps every node_modules and target dir, ignored
# or not. One the rules here miss stays on disk for every later job on that
# runner, and every tool that honors .gitignore scans it. Tue 29 Sep 2026: a
# branch that built apps/audio-engine left its cargo target/ behind, and jscpd
# read its dep-info .d files as 13 duplicated-code clones, failing the quality
# ratchet on every PR those runners took. Pinned by
# tests/scripts/test_ci_workspace_reuse.py.
node_modules/
target/

# --- Phase 11: SvelteKit frontend build artefacts ---
apps/webui/frontend/node_modules/
apps/webui/frontend/build/
apps/webui/frontend/.svelte-kit/
apps/webui/frontend/.vite/

# Tauri build artifact - platform-specific, do not commit
apps/launcher/src-tauri/Cargo.lock

# --- Agent orchestration churn (never commit) ---
# Mux / GSD sub-agent bookkeeping: CI-watcher snapshots, tmp scratch
# files, heartbeat directives and lock files. Transient per-run state;
# not useful in history and tends to collide across parallel agents.
.planning/ci-watcher-*.txt
.planning/ci-watcher-*.log
.planning/.tmp-*
.planning/.lock-*
.planning/heartbeats/

# ci-fixer lane (issue #1017): dedupe ledger + KPI event log are runtime
# state written by the lane (fleet-af ci_fixer/ since Thu 1 Oct 2026, run against
# this checkout), not source of truth for anything.
.planning/ci-fixer/

# --- Agent tool dirs (.claude / .codex / .agents / .cursor) ---
# Skills, rules, shared settings, and project agent docs ARE tracked so
# they sync across devices. Only per-machine / per-run runtime state is
# ignored below. Do not add blanket ignores for these top-level dirs.
.claude/worktrees/
.claude/checkpoints/
.claude/mailbox/
.claude/routines/.state/
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
.claude/agent-registry.json
.claude/agent-memory-local
.claude/first-run
.claude/assistant-daemon-state.json
# Machine-local Claude output-style prefs (global gitignore also covers this).
.claude/settings.local.json
.codex/**/cache/
.codex/**/*.log
.cursor/**/cache/
.cursor/**/*.log

# Session scratch + local backups (added 2026-06-05)
.tmp/
/blog/
maintainer/
/refs/
/Music/Recovered/

# Vocal quality-ladder audio clips (regenerated by scripts/modal_vocal_ladder.py;
# the ladder.json manifest IS committed, the .flac audio is not).
scripts/bench/clips/
# Same rule for the MUSDB18-HQ absolute ladder (scripts/modal_musdb_ladder.py):
# ladder_musdb.json is committed, its ~555MB of clips are not.
scripts/bench/clips-musdb/
# Same rule for the four-stem ladder (scripts/bench/four_stem_clips.py): the
# ladder_4stem*.json manifests are committed, their 54MB of m4a is not.
scripts/bench/clips-4stem/
# Same rule for the Mel-Band RoFormer spike (scripts/modal_roformer_spike.py):
# roformer_ledger.json is committed, its vocals/instrumental FLAC output is
# not -- durable copies live on the "roformer-spike" Modal Volume instead.
scripts/bench/clips-roformer-spike/
# Worktree-local orchestration state
/wt/
/zTasks.md
/.cccron/
docs/threads/.provenance-watermark.json
docs/threads/.provenance-lock
docs/threads/*.tmp

# Quality-gate run artifacts. The baseline is committed; the reports are not.
ops/quality/report.md
ops/quality/metrics.json

# /ship-dmg per-phase timing log (OPS-06): machine-local run history, not code.
ops/logs/

# Per-sha stable-channel evidence (OPS-18). Writers merge-append on the
# runner; the files describe a sha that cannot contain them, so they stay
# out of git. Keep ops/stable/.gitkeep tracked.
ops/stable/*.json

# Stretch-quality run artifacts. The report and results ARE committed (they are
# the deliverable that gates the STRETCH_BLOCK_MS flip); the audio is not.
# Renders alone are ~730MB per grid. Every PCM file's sha256 lives in
# results.json, so the committed artifacts still pin exactly what was measured.
ops/quality/stretch/work/

# WebKit performance-suite fixture library: generated audio + a state.db built
# by the real folder ingest at test setup (support/deckload_fixture.py). It is
# reproducible in seconds and is never shared with any other data dir.
apps/webui/frontend/tests/e2e/fixtures/deckload-data/
# Same builder, its own data dir (the engine takes a singleton lock on one),
