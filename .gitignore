apps/webui/frontend/tests/e2e/fixtures/lyrics-words-data/
apps/webui/frontend/tests/e2e/fixtures/lyrics-words-manifest.json
apps/webui/frontend/test-results/
apps/desktop/mcp/.smoke-data/
