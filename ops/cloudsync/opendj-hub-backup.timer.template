# TEMPLATE, rendered with opendj-hub.service by `just cloudsync-hub-start`.
# Nightly hub backup. Persistent=true runs a missed slot at the next boot.
[Unit]
Description=Nightly openDJ CloudSync hub backup

[Timer]
OnCalendar=__ON_CALENDAR__
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
